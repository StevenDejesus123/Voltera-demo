# Copy this file to .env and fill in your values.
# DO NOT commit .env to git.

# ── Salesforce ────────────────────────────────────────────────────────────────
SF_CONSUMER_KEY=
SF_CONSUMER_SECRET=
SF_DOMAIN=voltera.my

# ── PostgreSQL (Railway) ──────────────────────────────────────────────────────
# Get this from Railway: project → PostgreSQL service → Connect → DATABASE_URL
# Format: postgresql://user:password@host.railway.app:5432/railway
DATABASE_URL=

# ── SDG&E API credentials ─────────────────────────────────────────────────────
# Register free at: https://interconnectionmap-registration-form.sdge.com/
SDGE_USERNAME=
SDGE_PASSWORD=
